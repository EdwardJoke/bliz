    // It had drifted a release behind `version` in `src/main.zig`.
    .version = "0.4.0",
    .fingerprint = 0xf5499a1cb08d2ef2,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
